<?xml version="1.0" encoding="utf-8"?>
<!-- Artifact configuration to paste into the SignPath project.
     .github/workflows/release.yml uploads ShemaSetup.exe through actions/upload-artifact,
     which zips it, so the root is a zip-file holding the one exe we sign. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ShemaSetup.exe" product-name="Shema">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
